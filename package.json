    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "husky": "^9",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9",
    "typescript-eslint": "^8.68.0",
